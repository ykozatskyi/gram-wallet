# Copy this file to .env and fill in the values. Never commit .env.

# Leave this empty to run the local API without the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

TON_NETWORK=mainnet
TON_API_KEY=
TON_WALLET_ADDRESS=

# Sent in the X-Api-Key header on /api/gram
API_KEY=

# 24 words for the existing Wallet V5R1. Leave empty to keep signing disabled.
TON_MNEMONIC=

# false keeps payouts paused until an admin resumes them.
GRAM_PAYOUT_ENABLED=false
GRAM_MAX_PAYOUT=10
GRAM_MIN_RESERVE=0.1

DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=GRAMWalletDB;Username=username;Password=password;Pooling=true;Maximum Pool Size=200
